{
  "name": "workspace-reflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first contextual reflow browser extension for low-vision knowledge workers.",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "clean": "node scripts/clean.mjs",
    "build:extension": "wxt build",
    "build:site": "npm run clean && npm run build:extension && wxt zip && vite build --config site/vite.config.ts && node scripts/copy-package.mjs",
    "package:extension": "wxt zip && node scripts/copy-package.mjs",
    "build": "npm run build:site",
    "preview:site": "vite preview --config site/vite.config.ts",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:built": "playwright test",
    "test:claims": "vitest run --testNamePattern '@claim:' && npm run test:e2e -- --grep '@claim:'",
    "test:package": "node scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:package && npm run test:e2e:built"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.58.2",
    "@types/chrome": "0.0.287",
    "eslint": "10.9.1",
    "jsdom": "25.0.1",
    "playwright-core": "1.58.2",
    "sharp": "0.35.4",
    "typescript": "5.7.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  },
  "engines": {
    "node": ">=20.19"
  }
}
